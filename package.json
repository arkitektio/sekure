{
  "name": "sekure",
  "productName": "Sekure",
  "version": "1.1.0",
  "license": "MIT",
  "description": "Open, edit and unlock KeePass vaults on your computer",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "jhnnsrs",
  "homepage": "https://github.com/arkitektio/sekure",
  "repository": {
    "type": "git",
    "url": "https://github.com/arkitektio/sekure.git"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "start": "electron-vite preview",
    "dev": "cross-env NO_SANDBOX=1 electron-vite dev",
    "build": "electron-vite build",
    "icons": "node scripts/build-icons.mjs",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/notarize": "^3.1.1",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@huggingface/tokenizers": "0.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "cross-env": "^10.1.0",
    "electron": "43.1.0",
    "electron-builder": "26.9",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.0",
    "electron-updater": "^6.6.2",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "hash-wasm": "^4.12.0",
    "jsdom": "^29.1.1",
    "kdbxweb": "^2.1.1",
    "lucide-react": "^0.562.0",
    "onnxruntime-web": "1.30.0",
    "prettier": "^3.7.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.70.0",
    "react-resizable-panels": "^4.13.2",
    "react-router-dom": "^6.30.4",
    "semantic-release": "^24.2.9",
    "shadcn": "^3.6.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.9",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  }
}
