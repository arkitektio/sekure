# Google Cloud → APIs & Services → Credentials → OAuth client ID → "Desktop app".
# Desktop client secrets are not confidential (Google documents this); they are
# still kept out of git and injected at build time.
MAIN_VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
MAIN_VITE_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Sekure asks only for the drive.file scope, so vaults it did not create are
# chosen in the Google Picker. Credentials → API key, restricted to the
# "Google Picker API"; the app id is the project *number* (IAM → Settings).
MAIN_VITE_GOOGLE_API_KEY=AIzaxxxxxxxx
MAIN_VITE_GOOGLE_APP_ID=123456789012
